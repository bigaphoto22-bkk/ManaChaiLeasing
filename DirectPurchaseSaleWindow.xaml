<Window x:Class="ManaChaiLeasing.DirectPurchaseSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.DirectPurchaseSaleWindowTitle}"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="760"
        Height="820"
        MinWidth="700"
        MinHeight="680"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LargeSaleCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.55" ScaleY="1.55"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock x:Name="HeadingText"
                                   Text="ขายสินค้าที่รับซื้อ"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding DocumentNumber, StringFormat=เลขที่รับซื้อ: {0}}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#B45309"/>
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding SellerName, StringFormat=ผู้ขายเดิม: {0}}"
                                   FontSize="15"
                                   Foreground="#4B5563"/>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding ProductSummary}"
                                   FontSize="15"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="22"
                        Background="#FFF7ED"
                        BorderBrush="#FED7AA"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="วันที่รับซื้อ" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding PurchaseDate, StringFormat={}{0:dd/MM/yyyy}}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ราคารับซื้อ" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding PurchasePrice, StringFormat={}{0:N2} บาท}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock x:Name="SaleSectionHeadingText"
                                   Text="ข้อมูลการขาย"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="วันที่ขาย *" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
                                <DatePicker x:Name="SaleDatePicker"
                                            Margin="0,7,0,0"
                                            Height="46"
                                            FontSize="16"
                                            Padding="10,5"
                                            CalendarStyle="{StaticResource LargeSaleCalendarStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ราคาขาย *" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBox x:Name="SalePriceTextBox"
                                         Margin="0,7,0,0"
                                         Height="46"
                                         Padding="12,8"
                                         FontSize="18"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SalePriceTextBox_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="กำไร / ขาดทุนจากการซื้อขาย"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"/>
                                <TextBlock x:Name="ProfitText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="-"/>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,17,0,7" Text="ช่องทางการรับเงิน *" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
                        <ComboBox x:Name="PaymentMethodComboBox" Height="46" FontSize="16" Padding="10,6" SelectedIndex="0">
                            <ComboBoxItem Content="เงินสด"/>
                            <ComboBoxItem Content="โอนเงิน / LINE"/>
                        </ComboBox>

                        <TextBlock Margin="0,17,0,7" Text="หมายเหตุ (ไม่บังคับ)" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
                        <TextBox x:Name="SaleNoteTextBox"
                                 Height="68"
                                 Padding="12,9"
                                 FontSize="15"
                                 MaxLength="1000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Border x:Name="EditReasonBorder"
                                Margin="0,17,0,0"
                                Padding="16"
                                Background="#FFFBEB"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="เหตุผลการแก้ไข (ไม่บังคับ)"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"/>
                                <TextBox x:Name="EditReasonTextBox"
                                         Margin="0,7,0,0"
                                         Height="60"
                                         Padding="10,7"
                                         FontSize="14"
                                         MaxLength="1000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="หากเว้นว่าง Audit Log จะบันทึกว่า ไม่ได้ระบุ"
                                           FontSize="12"
                                           Foreground="#92400E"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FooterInfoText"
                           Margin="4,14,4,24"
                           Text="หลังยืนยัน รายการจะเปลี่ยนเป็นสถานะขายแล้วและแก้ไขข้อมูลรับซื้อไม่ได้"
                           FontSize="13"
                           Foreground="#B45309"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Height="48" Content="ยกเลิก" FontSize="16" Click="CancelButton_Click"/>
                <Button x:Name="SaveSaleButton"
                        Grid.Column="3"
                        Height="48"
                        Content="ยืนยันขายสินค้า"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="#B45309"
                        Foreground="White"
                        BorderBrush="#B45309"
                        IsDefault="True"
                        Click="SaveSaleButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
