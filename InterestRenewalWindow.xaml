<Window x:Class="ManaChaiLeasing.InterestRenewalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ต่อดอก - มานะชัย ลิสซิ่ง"
        Width="780"
        Height="720"
        MinWidth="720"
        MinHeight="650"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <Border Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ต่อดอก"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding TicketNumber, StringFormat=เลขตั๋ว: {0}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding CustomerName}"
                                   FontSize="17"
                                   Foreground="#374151" />

                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding ProductSummary}"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="เงื่อนไขของตั๋ว"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="เงินต้น"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding PrincipalAmountText}"
                                           Style="{StaticResource ValueStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ดอกเบี้ยต่อรอบ"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding InterestRateText}"
                                           Style="{StaticResource ValueStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ระยะเวลาต่อรอบ"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding InterestPeriodText}"
                                           Style="{StaticResource ValueStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ลำดับต่อดอก"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding InterestSequenceText}"
                                           Style="{StaticResource ValueStyle}"
                                           FontWeight="Bold"
                                           Foreground="#1D4ED8" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ครบกำหนดปัจจุบัน"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding CurrentDueDateText}"
                                           Style="{StaticResource ValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ครบกำหนดใหม่"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding NewDueDateText}"
                                           Style="{StaticResource ValueStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#15803D" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="24"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ยอดรับชำระดอกเบี้ย"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   Foreground="#1E3A8A" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding InterestAmountText}"
                                   HorizontalAlignment="Center"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="รายการนี้เป็นรายรับ และไม่เปลี่ยนเงินต้น"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#4B5563" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,26"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="การรับชำระ"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <TextBlock Margin="0,17,0,7"
                                   Text="ช่องทางการชำระเงิน"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <ComboBox x:Name="PaymentMethodComboBox"
                                  Height="48"
                                  FontSize="17"
                                  Padding="10,6"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="เงินสด" />
                            <ComboBoxItem Content="โอนเงิน / LINE" />
                        </ComboBox>

                        <TextBlock Margin="0,17,0,7"
                                   Text="หมายเหตุ (ไม่บังคับ)"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <TextBox x:Name="RenewalNoteTextBox"
                                 Height="82"
                                 Padding="12,9"
                                 FontSize="16"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Height="50"
                        Content="ยกเลิก"
                        FontSize="16"
                        Click="CancelButton_Click" />

                <Button x:Name="SaveInterestButton"
                        Grid.Column="3"
                        Height="50"
                        Content="ยืนยันต่อดอก"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#1D4ED8"
                        IsDefault="True"
                        Click="SaveInterestButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
