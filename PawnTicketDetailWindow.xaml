<Window x:Class="ManaChaiLeasing.PawnTicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.PawnTicketDetailWindowTitle}"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="1000"
        Height="760"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <Border Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="รายละเอียดตั๋วจำนำ"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding TicketNumber, StringFormat=เลขตั๋ว: {0}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusText}"
                                       HorizontalAlignment="Right"
                                       FontSize="18"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}"
                                                         Value="ไถ่ถอนแล้ว (Redeemed)">
                                                <Setter Property="Foreground"
                                                        Value="#475569" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}"
                                                         Value="จำหน่ายแล้ว (Sold)">
                                                <Setter Property="Foreground"
                                                        Value="#B45309" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding PrincipalAmountText}"
                                       HorizontalAlignment="Right"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRepawnSection}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="235" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ประวัติการนำสินค้ากลับมาจำนำ"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#166534" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding RepawnHistoryText}"
                                       FontSize="13"
                                       Foreground="#374151"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Height="48"
                                Content="จำนำสินค้าเดิมอีกครั้ง"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Background="#15803D"
                                Foreground="White"
                                BorderBrush="#15803D"
                                IsEnabled="{Binding CanRepawn}"
                                Click="RepawnItemButton_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลตั๋วและลูกค้า"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="วันที่รับจำนำ"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding PawnDateText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ชื่อ-นามสกุล"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding CustomerName}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="เลขบัตรประชาชน"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding CitizenId}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="อายุ"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding AgeText}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="เบอร์โทรศัพท์"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Phone}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                <TextBlock Text="ที่อยู่"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Address}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="24"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="เงื่อนไขตั๋ว"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ดอกเบี้ยต่อรอบ"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding InterestRateText}"
                                           Style="{StaticResource DetailValueStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ระยะเวลาต่อรอบ"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding InterestPeriodText}"
                                           Style="{StaticResource DetailValueStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ต่อดอกแล้ว"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding InterestRenewalCountText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="ครบกำหนดปัจจุบัน"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding CurrentDueDateText}"
                                           Style="{StaticResource DetailValueStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลสินค้า"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ประเภทหลัก"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding AssetCategory}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ประเภทสินค้า"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding ProductType}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="ยี่ห้อ"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Brand}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="รุ่น"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Model}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ความจุ / ขนาด"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding CapacityOrSize}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="สี"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Color}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="IMEI / Serial"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding ImeiOrSerial}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="อุปกรณ์"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Accessories}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="4">
                                <TextBlock Text="สภาพ / ตำหนิ"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding Condition}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,22,0,18" />

                        <TextBlock Text="รายละเอียดสินค้า"
                                   Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding ProductSummary}"
                                   Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Margin="0,18,0,4"
                                   Text="สเปก"
                                   Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding Specification}"
                                   Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Margin="0,18,0,4"
                                   Text="รายละเอียดอื่น ๆ"
                                   Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding OtherDetails}"
                                   Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Margin="0,18,0,4"
                                   Text="หมายเหตุ"
                                   Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding Note}"
                                   Style="{StaticResource DetailValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,28"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ประวัติรายการ"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <DataGrid ItemsSource="{Binding Transactions}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="44"
                                  FontSize="14"
                                  BorderBrush="#E5E7EB"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="วันที่"
                                                    Binding="{Binding TransactionDateText}"
                                                    Width="145" />
                                <DataGridTemplateColumn Header="รายการ"
                                                        Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TransactionTypeText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="#374151" />

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TransactionTypeText}"
                                                                         Value="จำนำ">
                                                                <Setter Property="Foreground"
                                                                        Value="#B45309" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding TransactionTypeText}"
                                                                         Value="ต่อดอก">
                                                                <Setter Property="Foreground"
                                                                        Value="#1D4ED8" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding TransactionTypeText}"
                                                                         Value="ไถ่ถอน">
                                                                <Setter Property="Foreground"
                                                                        Value="#047857" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding TransactionTypeText}"
                                                                         Value="จำหน่าย">
                                                                <Setter Property="Foreground"
                                                                        Value="#B45309" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="เงินเข้า/ออก"
                                                    Binding="{Binding CashFlowText}"
                                                    Width="110" />
                                <DataGridTextColumn Header="จำนวนเงิน"
                                                    Binding="{Binding AmountText}"
                                                    Width="125" />
                                <DataGridTextColumn Header="ครั้งที่"
                                                    Binding="{Binding InterestSequenceText}"
                                                    Width="75" />
                                <DataGridTextColumn Header="ช่องทาง"
                                                    Binding="{Binding PaymentMethod}"
                                                    Width="110" />
                                <DataGridTextColumn Header="หมายเหตุ"
                                                    Binding="{Binding Note}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,28"
                        Padding="24"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ประวัติการแก้ไขข้อมูล"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding EditAuditCountText}"
                                       FontSize="13"
                                       Foreground="#6B7280" />
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="ยังไม่มีการแก้ไขข้อมูลตั๋วนี้"
                                   FontSize="14"
                                   Foreground="#6B7280">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEditAudits}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding EditAudits}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEditAudits}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding EditedAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding EditorText}"
                                                           FontSize="13"
                                                           Foreground="#6B7280"
                                                           TextWrapping="Wrap" />
                                            </Grid>

                                            <TextBlock Margin="0,9,0,0"
                                                       FontSize="14"
                                                       Foreground="#111827"
                                                       TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold"
                                                     Text="เหตุผล: " />
                                                <Run Text="{Binding Reason}" />
                                            </TextBlock>

                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding ChangeSummary}"
                                                       FontSize="13"
                                                       Foreground="#374151"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="175"
                        Height="48"
                        HorizontalAlignment="Left"
                        Content="แก้ไขข้อมูล"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="White"
                        Foreground="#1D4ED8"
                        BorderBrush="#1D4ED8"
                        Click="EditTicketButton_Click" />

                <Button Grid.Column="1"
                        Height="48"
                        Content="ต่อดอก"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#1D4ED8"
                        IsEnabled="{Binding CanRenew}"
                        Click="RenewInterestButton_Click" />

                <Button Grid.Column="3"
                        Height="48"
                        Content="ไถ่ถอน"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="#047857"
                        Foreground="White"
                        BorderBrush="#047857"
                        IsEnabled="{Binding CanRedeem}"
                        Click="RedeemButton_Click" />

                <Button Grid.Column="5"
                        Height="48"
                        Content="จำหน่ายสินค้า"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#B45309"
                        Foreground="White"
                        BorderBrush="#B45309"
                        IsEnabled="{Binding CanSell}"
                        ToolTip="จำหน่ายได้เฉพาะตั๋วที่เกินกำหนด"
                        Click="SellButton_Click" />

                <Button Grid.Column="7"
                        Height="48"
                        Content="ปิด"
                        FontSize="16"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
