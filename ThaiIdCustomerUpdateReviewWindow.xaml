<Window x:Class="ManaChaiLeasing.ThaiIdCustomerUpdateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="900"
        Height="720"
        MinWidth="820"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SmallHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>

        <Style x:Key="OldValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NewValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChangeRowStyle"
               TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="ตรวจสอบข้อมูลลูกค้าเดิมกับข้อมูลจากบัตร"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#111827" />

                <TextBlock x:Name="CustomerIdentityText"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#4B5563" />

                <TextBlock x:Name="MatchSummaryText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B45309" />

                <TextBlock x:Name="MockWarningText"
                           Margin="0,10,0,0"
                           Padding="10"
                           Background="#FEF2F2"
                           Foreground="#B91C1C"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="DEV MOCK • การเลือกด้านล่างมีผลเฉพาะกับฟอร์มทดสอบ และระบบยังป้องกันไม่ให้บันทึกลงฐานข้อมูล" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="12"
                        Margin="0,0,0,12"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock FontSize="13"
                               Foreground="#1D4ED8"
                               TextWrapping="Wrap"
                               Text="ระบบจะไม่เขียนทับข้อมูลลูกค้าอัตโนมัติ • ทำเครื่องหมายเฉพาะช่องที่ต้องการใช้ข้อมูลล่าสุดจากบัตร แล้วตรวจสอบฟอร์มอีกครั้งก่อนบันทึก" />
                </Border>

                <Border x:Name="NoChangesBorder"
                        Padding="14"
                        Margin="0,0,0,12"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock Text="ข้อมูลที่ระบบใช้ในฟอร์มตรงกับข้อมูลจากบัตรแล้ว ไม่พบรายการที่ต้องอัปเดต"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#047857"
                               TextWrapping="Wrap" />
                </Border>

                <Grid x:Name="ColumnHeaderGrid"
                      Margin="14,0,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="เลือกข้อมูลที่จะอัปเดต"
                               Style="{StaticResource SmallHeaderStyle}" />

                    <TextBlock Grid.Column="1"
                               Text="ข้อมูลเดิมในระบบ"
                               Style="{StaticResource SmallHeaderStyle}" />

                    <TextBlock Grid.Column="3"
                               Text="ข้อมูลจากบัตรล่าสุด"
                               Style="{StaticResource SmallHeaderStyle}" />
                </Grid>

                <Border x:Name="FirstNameChangeRow"
                        Style="{StaticResource ChangeRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="FirstNameCheckBox"
                                  Grid.Column="0"
                                  Content="ชื่อ"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Checked="SelectionCheckBox_Changed"
                                  Unchecked="SelectionCheckBox_Changed" />

                        <TextBlock x:Name="OldFirstNameText"
                                   Grid.Column="1"
                                   Style="{StaticResource OldValueStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF" />

                        <TextBlock x:Name="NewFirstNameText"
                                   Grid.Column="3"
                                   Style="{StaticResource NewValueStyle}" />
                    </Grid>
                </Border>

                <Border x:Name="LastNameChangeRow"
                        Style="{StaticResource ChangeRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="LastNameCheckBox"
                                  Grid.Column="0"
                                  Content="นามสกุล"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Checked="SelectionCheckBox_Changed"
                                  Unchecked="SelectionCheckBox_Changed" />

                        <TextBlock x:Name="OldLastNameText"
                                   Grid.Column="1"
                                   Style="{StaticResource OldValueStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF" />

                        <TextBlock x:Name="NewLastNameText"
                                   Grid.Column="3"
                                   Style="{StaticResource NewValueStyle}" />
                    </Grid>
                </Border>

                <Border x:Name="AgeChangeRow"
                        Style="{StaticResource ChangeRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="AgeCheckBox"
                                  Grid.Column="0"
                                  Content="อายุ"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Checked="SelectionCheckBox_Changed"
                                  Unchecked="SelectionCheckBox_Changed" />

                        <TextBlock x:Name="OldAgeText"
                                   Grid.Column="1"
                                   Style="{StaticResource OldValueStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF" />

                        <TextBlock x:Name="NewAgeText"
                                   Grid.Column="3"
                                   Style="{StaticResource NewValueStyle}" />
                    </Grid>
                </Border>

                <Border x:Name="AddressChangeRow"
                        Style="{StaticResource ChangeRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="AddressCheckBox"
                                  Grid.Column="0"
                                  Content="ที่อยู่"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Checked="SelectionCheckBox_Changed"
                                  Unchecked="SelectionCheckBox_Changed" />

                        <TextBlock x:Name="OldAddressText"
                                   Grid.Column="1"
                                   Style="{StaticResource OldValueStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,2,0,0"
                                   Foreground="#9CA3AF" />

                        <TextBlock x:Name="NewAddressText"
                                   Grid.Column="3"
                                   Style="{StaticResource NewValueStyle}" />
                    </Grid>
                </Border>

                <Border Padding="12"
                        Margin="0,4,0,0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock FontSize="12"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Text="เบอร์โทรศัพท์จะคงข้อมูลเดิมเสมอ เพราะบัตรประชาชนไม่มีข้อมูลเบอร์โทรศัพท์ • ช่องที่บัตรอ่านไม่ได้หรือเป็นค่าว่างจะไม่ถูกเสนอให้เขียนทับข้อมูลเดิม" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="12"
                       Text="2N.4 • Review ก่อนเปลี่ยนข้อมูลในฟอร์ม" />

            <Button x:Name="SelectAllButton"
                    Grid.Column="1"
                    Width="125"
                    Height="42"
                    Content="เลือกทั้งหมด"
                    Click="SelectAllButton_Click" />

            <Button Grid.Column="3"
                    Width="135"
                    Height="42"
                    Content="ใช้ข้อมูลเดิม"
                    IsCancel="True"
                    Click="KeepExistingButton_Click" />

            <Button x:Name="ApplySelectedButton"
                    Grid.Column="5"
                    Width="205"
                    Height="42"
                    Content="นำรายการที่เลือกไปใช้"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    Click="ApplySelectedButton_Click" />
        </Grid>
    </Grid>
</Window>
