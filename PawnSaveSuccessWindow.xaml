<Window x:Class="ManaChaiLeasing.PawnSaveSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="บันทึกตั๋วจำนำสำเร็จ - มานะชัย ลิสซิ่ง"
        Width="570"
        Height="455"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center">
            <TextBlock Text="✓ บันทึกสำเร็จ"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#15803D" />

            <TextBlock Margin="0,7,0,0"
                       Text="บันทึกตั๋วจำนำเรียบร้อยแล้ว"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Foreground="#374151" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="เลขตั๋ว"
                           FontSize="18"
                           Foreground="#4B5563" />
                <TextBlock x:Name="TicketNumberText"
                           Grid.Row="0"
                           Grid.Column="1"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="2"
                           Text="ยอดเงิน"
                           FontSize="18"
                           Foreground="#4B5563" />
                <TextBlock x:Name="AmountText"
                           Grid.Row="2"
                           Grid.Column="1"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#111827" />

                <TextBlock Grid.Row="4"
                           Text="สถานะ"
                           FontSize="18"
                           Foreground="#4B5563" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="กำลังจำนำ (Active)"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#15803D" />

                <TextBlock Grid.Row="6"
                           Text="กระแสเงินสด"
                           FontSize="18"
                           Foreground="#4B5563" />
                <TextBlock x:Name="CashFlowText"
                           Grid.Row="6"
                           Grid.Column="1"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#B45309" />
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Width="150"
                Height="52"
                HorizontalAlignment="Center"
                Content="ตกลง"
                FontSize="18"
                FontWeight="SemiBold"
                IsDefault="True"
                Click="OkButton_Click" />
    </Grid>
</Window>
