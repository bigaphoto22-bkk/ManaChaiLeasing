<Window x:Class="ManaChaiLeasing.DirectPurchaseCancelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.DirectPurchaseCancelWindowTitle}"
        Icon="Resources/ManaChaiLeasing.ico" Width="580" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F6F8" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="ยกเลิกรายการรับซื้อ" FontSize="25" FontWeight="Bold" Foreground="#B91C1C"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,8,0,0" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3">
            <TextBlock Text="เหตุผลการยกเลิก *" FontSize="15" FontWeight="SemiBold"/>
            <TextBox x:Name="ReasonTextBox" Margin="0,8,0,0" Height="110" Padding="10" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000"/>
            <TextBlock Margin="0,9,0,0" Text="ใช้เมื่อบันทึกผิดหรือรายการซ้ำ ยอดจ่ายรับซื้อจะถูกตัดออกจากสรุปเงินสด และสินค้าไม่สามารถนำไปขายได้" FontSize="12" Foreground="#B45309" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Height="44" Content="กลับ" Click="BackButton_Click"/>
            <Button Grid.Column="3" Height="44" Content="ยืนยันยกเลิกรายการ" Background="#B91C1C" Foreground="White" BorderBrush="#B91C1C" FontWeight="SemiBold" Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
