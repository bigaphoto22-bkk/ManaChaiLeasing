<Window x:Class="ManaChaiLeasing.CustomerLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.CustomerLookupWindowTitle}"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ค้นหาลูกค้าเก่า"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Margin="0,5,0,0"
                       Text="พิมพ์ชื่อ นามสกุล เลขบัตรประชาชน เบอร์โทรศัพท์ หรือที่อยู่ ระบบจะค้นหาให้ทันที"
                       FontSize="13"
                       Foreground="#6B7280"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <TextBox x:Name="SearchTextBox"
                     BorderThickness="0"
                     FontSize="15"
                     Background="Transparent"
                     VerticalContentAlignment="Center" />
        </Border>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">

            <DataGrid x:Name="CustomerGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="42"
                      FontSize="13"
                      MouseDoubleClick="CustomerGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ชื่อ"
                                        Binding="{Binding FirstName}"
                                        Width="140" />
                    <DataGridTextColumn Header="นามสกุล"
                                        Binding="{Binding LastName}"
                                        Width="160" />
                    <DataGridTextColumn Header="เลขบัตรประชาชน"
                                        Binding="{Binding CitizenId}"
                                        Width="150" />
                    <DataGridTextColumn Header="เบอร์โทรศัพท์"
                                        Binding="{Binding Phone}"
                                        Width="130" />
                    <DataGridTextColumn Header="ที่อยู่"
                                        Binding="{Binding Address}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ResultCountText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#6B7280" />

            <Button Grid.Column="1"
                    Width="100"
                    Height="40"
                    Content="ยกเลิก"
                    Click="CancelButton_Click" />

            <Button Grid.Column="3"
                    Width="150"
                    Height="40"
                    Content="เลือกข้อมูลลูกค้า"
                    FontWeight="SemiBold"
                    Click="SelectCustomerButton_Click" />
        </Grid>

    </Grid>

</Window>
