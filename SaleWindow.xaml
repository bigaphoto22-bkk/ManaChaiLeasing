<Window x:Class="ManaChaiLeasing.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.SaleWindowTitle}"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="780"
        Height="820"
        MinWidth="720"
        MinHeight="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <Border Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="จำหน่ายสินค้า"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding TicketNumber, StringFormat=เลขตั๋ว: {0}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#B45309" />

                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding CustomerName}"
                                   FontSize="17"
                                   Foreground="#374151" />

                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding ProductSummary}"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="24"
                        Background="#FFF7ED"
                        BorderBrush="#FED7AA"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="เงินต้น"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding PrincipalAmountText}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ครบกำหนด"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding CurrentDueDateText}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="สถานะ"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding OverdueText}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="#B91C1C" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="24"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลการจำหน่าย"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="วันที่จำหน่าย *"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#374151" />
                                <DatePicker x:Name="SaleDatePicker"
                                            Margin="0,7,0,0"
                                            Height="48"
                                            FontSize="16"
                                            Padding="10,5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ราคาจำหน่าย *"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#374151" />
                                <TextBox x:Name="SaleAmountTextBox"
                                         Margin="0,7,0,0"
                                         Height="48"
                                         Padding="12,8"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SaleAmountTextBox_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Text="กำไร / ขาดทุนจากการจำหน่าย"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#475569" />

                                <TextBlock x:Name="SaleProfitText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="-" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,17,0,7"
                                   Text="ช่องทางการรับเงิน *"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <ComboBox x:Name="PaymentMethodComboBox"
                                  Height="48"
                                  FontSize="17"
                                  Padding="10,6"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="เงินสด" />
                            <ComboBoxItem Content="โอนเงิน / LINE" />
                        </ComboBox>

                        <TextBlock Margin="0,17,0,7"
                                   Text="หมายเหตุ (ไม่บังคับ)"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <TextBox x:Name="SaleNoteTextBox"
                                 Height="72"
                                 Padding="12,9"
                                 FontSize="16"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="4,14,4,26"
                           Text="หลังยืนยัน ตั๋วจะเปลี่ยนเป็นสถานะจำหน่ายแล้ว และไม่สามารถต่อดอกหรือไถ่ถอนได้อีก"
                           FontSize="13"
                           Foreground="#B45309"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Height="50"
                        Content="ยกเลิก"
                        FontSize="16"
                        Click="CancelButton_Click" />

                <Button x:Name="SaveSaleButton"
                        Grid.Column="3"
                        Height="50"
                        Content="ยืนยันจำหน่าย"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="#B45309"
                        Foreground="White"
                        BorderBrush="#B45309"
                        IsDefault="True"
                        Click="SaveSaleButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
