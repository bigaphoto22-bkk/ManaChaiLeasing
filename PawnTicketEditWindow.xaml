<Window x:Class="ManaChaiLeasing.PawnTicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        Title="{x:Static local:AppInfo.PawnTicketEditWindowTitle}"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="1040"
        Height="820"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="EditLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

        <Style x:Key="EditTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="EditDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectedDateFormat" Value="Short" />
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="แก้ไขข้อมูลตั๋วจำนำ"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#111827" />

                        <TextBlock x:Name="TicketNumberText"
                                   Margin="0,7,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8" />

                        <TextBlock x:Name="LockedTicketSummaryText"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16,13"
                        Background="#FFF7ED"
                        BorderBrush="#FED7AA"
                        BorderThickness="1"
                        CornerRadius="9">
                    <TextBlock FontSize="14"
                               Foreground="#9A3412"
                               TextWrapping="Wrap">
                        <Run FontWeight="Bold"
                             Text="ข้อควรทราบ: " />
                        <Run Text="ข้อมูลลูกค้าใช้ร่วมกันทุกตั๋วของลูกค้ารายนี้ การแก้ชื่อ เลขบัตร โทรศัพท์ หรือที่อยู่ จะมีผลกับทุกตั๋ว ส่วนเงินต้น ดอกเบี้ย สถานะ และประวัติรับ–จ่ายยังคงถูกล็อกไว้" />
                    </TextBlock>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลตั๋ว"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="เลขตั๋ว *"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="EditableTicketNumberTextBox"
                                         MaxLength="50"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="วันที่จำนำ *"
                                           Style="{StaticResource EditLabelStyle}" />
                                <DatePicker x:Name="EditablePawnDatePicker"
                                            Style="{StaticResource EditDatePickerStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                                   Text="หากตั๋วเคยต่อดอกแล้ว ระบบจะรักษาวันครบกำหนดล่าสุดไว้ ไม่เลื่อนตามวันที่จำนำที่แก้ไข"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลลูกค้า"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ชื่อ *"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="FirstNameTextBox"
                                         MaxLength="100"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="นามสกุล *"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="LastNameTextBox"
                                         MaxLength="100"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="เลขบัตรประชาชน"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="CitizenIdTextBox"
                                         MaxLength="13"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="อายุ"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="AgeTextBox"
                                         MaxLength="3"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="โทรศัพท์"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="PhoneTextBox"
                                         MaxLength="30"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="6"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                <TextBlock Text="ที่อยู่"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="AddressTextBox"
                                         Height="88"
                                         MaxLength="1000"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ข้อมูลสินค้า"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ประเภทหลัก *"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="AssetCategoryTextBox"
                                         MaxLength="100"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ประเภทสินค้า"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="ProductTypeTextBox"
                                         MaxLength="100"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="ยี่ห้อ"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="BrandTextBox"
                                         MaxLength="100"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="รุ่น"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="ModelTextBox"
                                         MaxLength="200"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ความจุ / ขนาด"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="CapacityOrSizeTextBox"
                                         MaxLength="100"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="สี"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="ColorTextBox"
                                         MaxLength="100"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="IMEI / Serial"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="ImeiOrSerialTextBox"
                                         MaxLength="150"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="อุปกรณ์"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="AccessoriesTextBox"
                                         MaxLength="500"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="4">
                                <TextBlock Text="สภาพ / ตำหนิ"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="ConditionTextBox"
                                         MaxLength="1000"
                                         TextChanged="ProductField_TextChanged"
                                         Style="{StaticResource EditTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="สเปก"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="SpecificationTextBox"
                                         Height="90"
                                         MaxLength="1500"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="ProductField_TextChanged"
                                         FontSize="14" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="รายละเอียดอื่น ๆ"
                                           Style="{StaticResource EditLabelStyle}" />
                                <TextBox x:Name="OtherDetailsTextBox"
                                         Height="90"
                                         MaxLength="1500"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="ProductField_TextChanged"
                                         FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,18,0,6"
                                   Text="รายละเอียดสินค้าสรุป *"
                                   Style="{StaticResource EditLabelStyle}" />
                        <TextBlock Margin="0,0,0,8"
                                   Text="สร้างจากข้อมูลด้านบนอัตโนมัติ และสามารถแก้ข้อความสรุปด้วยมือได้หลังกรอกข้อมูลด้านบนเสร็จ"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="ProductSummaryTextBox"
                                 Height="100"
                                 MaxLength="2500"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14" />

                        <TextBlock Margin="0,18,0,6"
                                   Text="หมายเหตุตั๋ว"
                                   Style="{StaticResource EditLabelStyle}" />
                        <TextBox x:Name="TicketNoteTextBox"
                                 Height="88"
                                 MaxLength="1500"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,28"
                        Padding="22"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="เหตุผลการแก้ไข (ไม่บังคับ)"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E" />
                        <TextBlock Margin="0,5,0,10"
                                   Text="ถ้าระบุ เหตุผลนี้และค่าก่อน–หลังจะถูกเก็บไว้ในประวัติ หากเว้นว่างระบบจะแสดงว่าไม่ได้ระบุ"
                                   FontSize="13"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="EditReasonTextBox"
                                 Height="88"
                                 MaxLength="1000"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="205" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="เงินต้น ดอกเบี้ย สถานะ และประวัติรับ–จ่ายถูกล็อกและจะไม่ถูกเปลี่ยน"
                           FontSize="12"
                           Foreground="#6B7280" />

                <Button Grid.Column="1"
                        Height="48"
                        Content="ยกเลิก"
                        FontSize="16"
                        Click="CancelButton_Click" />

                <Button x:Name="SaveEditButton"
                        Grid.Column="3"
                        Height="48"
                        Content="บันทึกการแก้ไข"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        IsDefault="True"
                        Click="SaveEditButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
