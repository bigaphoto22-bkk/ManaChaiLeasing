                                                            <Setter Property="Foreground"
                                                                    Value="#4B5563" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}"
                                                                             Value="กำลังจำนำ">
                                                                    <Setter Property="Foreground"
                                                                            Value="#15803D" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding StatusText}"
