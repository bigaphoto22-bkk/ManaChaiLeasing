                                                                    <Setter Property="Foreground"
                                                                            Value="#1F2937" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding StatusText}"
                                                                             Value="ปิดรายการ">
                                                                    <Setter Property="Foreground"
                                                                            Value="#6B7280" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding StatusText}"
                                                                             Value="จำหน่ายแล้ว">
                                                                    <Setter Property="Foreground"
                                                                            Value="#B45309" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

