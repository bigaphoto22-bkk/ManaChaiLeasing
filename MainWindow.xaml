                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#B91C1C" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
