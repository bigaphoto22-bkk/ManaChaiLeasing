                                           Foreground="#111827" />

                                <TextBlock Margin="0,8,0,0"
                                           Text="สำรองฐานข้อมูลลูกค้า ตั๋วจำนำ และประวัติรายการทั้งหมดเป็นไฟล์ .db สำหรับเก็บไว้ใน Flash Drive, External Drive หรือพื้นที่สำรองข้อมูลอื่น"
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,18,0,0"
                                        Padding="18"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="ฐานข้อมูลที่กำลังใช้งาน"
                                                   FontSize="13"
                                                   Foreground="#64748B" />

                                        <TextBlock x:Name="DatabaseFilePathText"
                                                   Margin="0,5,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Height="50"
                                            Content="สำรองข้อมูล..."
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BackupDatabaseButton_Click" />

                                    <Button Grid.Column="2"
                                            Height="50"
                                            Content="กู้คืนข้อมูล..."
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RestoreDatabaseButton_Click" />
                                </Grid>

                                <TextBlock x:Name="DatabaseBackupStatusText"
                                           Margin="0,14,0,0"
                                           Text="ยังไม่มีการสำรองหรือกู้คืนข้อมูลในรอบการเปิดโปรแกรมนี้"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="#FFFBEB"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontSize="13"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap"
                                               Text="ก่อนกู้คืน ระบบจะสร้าง Backup ของข้อมูลปัจจุบันให้อัตโนมัติ และเมื่อกู้คืนสำเร็จโปรแกรมจะปิดเพื่อให้เปิดใหม่ด้วยฐานข้อมูลที่กู้คืน" />
                                </Border>

                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock FontSize="13"
                                       Foreground="#1E3A8A"
                                       TextWrapping="Wrap"
                                       Text="Phase 2I : Backup / Restore — สำรอง SQLite แบบ Online Backup, ตรวจสอบไฟล์ก่อน Restore และสร้าง Safety Backup อัตโนมัติก่อนกู้คืน" />
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>
