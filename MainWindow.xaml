                                               Foreground="#92400E"
                                               TextWrapping="Wrap"
                                               Text="ก่อนกู้คืน ระบบจะสร้าง Backup ของข้อมูลปัจจุบันให้อัตโนมัติ และเมื่อกู้คืนสำเร็จโปรแกรมจะปิดเพื่อให้เปิดใหม่ด้วยฐานข้อมูลที่กู้คืน" />
                                </Border>

                                <Expander Margin="0,14,0,0"
                                          Header="ตัวเลือกเพิ่มเติม"
                                          FontSize="13"
                                          Foreground="#475569"
                                          IsExpanded="False">
                                    <Border Margin="0,8,0,0"
                                            Padding="14"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="สำรองข้อมูลด้วยตนเอง"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151" />

                                            <TextBlock Margin="0,3,0,0"
                                                       Text="ใช้เมื่อต้องการเก็บ Snapshot แยกเพิ่มเติมจาก Auto Backup"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap" />

                                            <Button Margin="0,10,0,0"
                                                    Width="210"
                                                    Height="42"
                                                    HorizontalAlignment="Left"
                                                    Content="สำรองข้อมูลด้วยตนเอง..."
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="BackupDatabaseButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock FontSize="13"
                                       Foreground="#1E3A8A"
                                       TextWrapping="Wrap"
                                       Text="คำแนะนำ: สำหรับใช้งานจริง ควรเก็บ Auto Backup ไว้นอก Drive ที่ติดตั้ง Windows เช่น Flash Drive, External Drive หรือ Drive สำรองอื่น" />
                        </Border>

                        <Expander Margin="0,18,0,0"
                                  Header="ช่วยเหลือ / ตรวจสอบปัญหา"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="#374151"
                                  IsExpanded="False">
                            <Border Margin="0,8,0,0"
                                    Padding="20"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Technical Log &amp; Support Diagnostics"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />

                                    <TextBlock Margin="0,5,0,0"
                                               Text="ใช้เมื่อต้องการส่งข้อมูลทางเทคนิคให้ผู้พัฒนาเพื่อตรวจสอบปัญหาจากระยะไกล"
                                               FontSize="13"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap" />

                                    <TextBlock x:Name="SupportDiagnosticsLogPathText"
                                               Margin="0,12,0,0"
                                               FontSize="12"
                                               Foreground="#475569"
                                               TextWrapping="Wrap" />

                                    <TextBlock x:Name="SupportDiagnosticsStatusText"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap" />

                                    <StackPanel Margin="0,14,0,0"
                                                Orientation="Horizontal">
                                        <Button Width="185"
                                                Height="42"
                                                Content="เปิดโฟลเดอร์ Log"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OpenTechnicalLogFolderButton_Click" />

                                        <Button Width="210"
                                                Height="42"
                                                Margin="12,0,0,0"
                                                Content="สร้างชุดข้อมูล Support..."
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="CreateSupportPackageButton_Click" />
                                    </StackPanel>

                                    <Border Margin="0,14,0,0"
                                            Padding="12"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBlock FontSize="12"
                                                   Foreground="#475569"
                                                   TextWrapping="Wrap"
                                                   Text="เพื่อความเป็นส่วนตัว ชุด Support ไม่รวมฐานข้อมูล, Backup, ไฟล์ License, Private Key หรือข้อมูลลูกค้า" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>
