<Window x:Class="ManaChaiLeasing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static local:AppInfo.StoreName}"
        Icon="Resources/ManaChaiLeasing.ico"
        Width="1280"
        Height="760"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActiveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PlaceholderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FormSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="StaysOpenOnEdit" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <EventSetter Event="PreviewMouseLeftButtonUp"
                         Handler="FormComboBox_PreviewMouseLeftButtonUp" />
        </Style>

        <!-- Keep the date field aligned with the form, but enlarge the
             calendar popup so dates and month navigation are easier to use. -->
        <Style x:Key="LargePawnCalendarStyle"
               TargetType="{x:Type Calendar}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.55"
                                    ScaleY="1.55" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="105" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="94" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0">
                        <TextBlock Text="{x:Static local:AppInfo.StoreName}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="0,18,0,0">

                    <TextBlock Text="เมนูหลัก"
                               Margin="30,0,0,10"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF" />

                    <Button x:Name="HomeButton"
                            Content="หน้าหลัก"
                            Style="{StaticResource SidebarActiveButtonStyle}"
                            Click="HomeButton_Click" />

                    <Button x:Name="NewPawnButton"
                            Content="รับจำนำใหม่"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NewPawnButton_Click" />

                    <Button x:Name="SearchButton"
                            Content="ค้นหารายการ"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SearchButton_Click" />

                    <Button x:Name="TodayButton"
                            Content="รายการวันนี้"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="TodayButton_Click" />

                    <Button x:Name="DirectPurchaseButton"
                            Content="รายการซื้อขาย"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="DirectPurchaseButton_Click" />

                    <Separator Margin="24,14"
                               Background="#E5E7EB" />

                    <Button x:Name="SettingsButton"
                            Content="ตั้งค่า"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SettingsButton_Click" />

                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0">
                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0">
                        <TextBlock Text="{x:Static local:AppInfo.StoreName}"
                                   FontSize="12"
                                   Foreground="#6B7280" />

                        <TextBlock Text="{x:Static local:AppInfo.ProductVersionText}"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B" />

                        <TextBlock x:Name="DatabaseStatusText"
                                   Text="กำลังเตรียมฐานข้อมูล..."
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#9CA3AF" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="หน้าหลัก"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <TextBlock x:Name="PageSubtitleText"
                                   Text="ระบบบันทึกข้อมูลลูกค้าและรายการรับจำนำ"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#F3F4F6"
                            CornerRadius="8"
                            Padding="14,8">
                        <TextBlock Text="Offline"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563" />
                    </Border>
                </Grid>

            </Border>

            <!-- Page content -->
            <Grid Grid.Row="1">

                <!-- Home -->
                <ScrollViewer x:Name="HomeContent"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,26,32,32">

                        <!-- Compact dashboard header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="ภาพรวม"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#111827" />

                                <TextBlock x:Name="HomeDashboardPeriodText"
                                           Margin="0,5,0,0"
                                           FontSize="14"
                                           Foreground="#6B7280" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <Button Width="118"
                                        Height="40"
                                        Content="รีเฟรช"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshHomeDashboardButton_Click" />

                                <TextBlock x:Name="HomeDashboardUpdatedText"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="#9CA3AF" />
                            </StackPanel>
                        </Grid>

                        <!-- Period selector -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="HomeDashboardTodayButton"
                                    Grid.Column="0"
                                    MinWidth="104"
                                    Height="40"
                                    Content="วันนี้"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="HomeDashboardTodayButton_Click" />

                            <Button x:Name="HomeDashboardWeekButton"
                                    Grid.Column="2"
                                    MinWidth="116"
                                    Height="40"
                                    Content="สัปดาห์นี้"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="HomeDashboardWeekButton_Click" />

                            <Button x:Name="HomeDashboardMonthButton"
                                    Grid.Column="4"
                                    MinWidth="110"
                                    Height="40"
                                    Content="เดือนนี้"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="HomeDashboardMonthButton_Click" />

                            <Button x:Name="HomeDashboardCustomButton"
                                    Grid.Column="6"
                                    MinWidth="112"
                                    Height="40"
                                    Content="กำหนดเอง"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="HomeDashboardCustomButton_Click" />
                        </Grid>

                        <!-- Custom date range: shown only when Custom is selected -->
                        <Border x:Name="HomeDashboardCustomRangePanel"
                                Margin="0,12,0,0"
                                Padding="14"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="วันที่เริ่มต้น"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#374151" />

                                <DatePicker x:Name="HomeCustomStartDatePicker"
                                            Width="155"
                                            Height="40"
                                            FontSize="14"
                                            SelectedDateFormat="Short"
                                            VerticalContentAlignment="Center" />

                                <TextBlock Text="ถึง"
                                           Margin="14,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="#6B7280" />

                                <DatePicker x:Name="HomeCustomEndDatePicker"
                                            Width="155"
                                            Height="40"
                                            FontSize="14"
                                            SelectedDateFormat="Short"
                                            VerticalContentAlignment="Center" />

                                <Button Margin="14,0,0,0"
                                        MinWidth="112"
                                        Height="40"
                                        Content="ดูข้อมูล"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="HomeDashboardApplyCustomButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Status: compact one-row summary, not three large cards -->
                        <TextBlock Margin="0,22,0,10"
                                   Text="สถานะ ณ วันสิ้นสุด"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="20,14"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="กำลังจำนำ"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#4B5563" />
                                    <TextBlock x:Name="HomeActiveTicketCountText"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#15803D" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="0,12"
                                        Background="#E5E7EB" />

                                <StackPanel Grid.Column="2"
                                            Margin="20,14"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="ครบกำหนด"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#4B5563" />
                                    <TextBlock x:Name="HomeDueAtEndCountText"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Margin="0,12"
                                        Background="#E5E7EB" />

                                <StackPanel Grid.Column="4"
                                            Margin="20,14"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="เกินกำหนด"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#4B5563" />
                                    <TextBlock x:Name="HomeOverdueCountText"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#B91C1C" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main activity cards -->
                        <TextBlock Margin="0,22,0,10"
                                   Text="ความเคลื่อนไหว"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="20,18"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="จำนำใหม่ / รับซื้อ"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#374151" />
                                    <TextBlock x:Name="HomePawnCountText"
                                               Margin="0,7,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                    <TextBlock x:Name="HomePawnExpenseText"
                                               Margin="0,3,0,0"
                                               FontSize="14"
                                               Foreground="#92400E" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="20,18"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="ต่อดอก"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#374151" />
                                    <TextBlock x:Name="HomeInterestCountText"
                                               Margin="0,7,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#1D4ED8" />
                                    <TextBlock x:Name="HomeInterestIncomeText"
                                               Margin="0,3,0,0"
                                               FontSize="14"
                                               Foreground="#1E40AF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="20,18"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="ไถ่ถอน"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#374151" />
                                    <TextBlock x:Name="HomeRedemptionCountText"
                                               Margin="0,7,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#047857" />
                                    <TextBlock x:Name="HomeRedemptionIncomeText"
                                               Margin="0,3,0,0"
                                               FontSize="14"
                                               Foreground="#047857" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6"
                                    Padding="20,18"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="จำหน่าย"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#374151" />
                                    <TextBlock x:Name="HomeSaleCountText"
                                               Margin="0,7,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                    <TextBlock x:Name="HomeSaleIncomeText"
                                               Margin="0,3,0,0"
                                               FontSize="14"
                                               Foreground="#92400E" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Cash summary: one compact row -->
                        <TextBlock Margin="0,22,0,10"
                                   Text="สรุปเงินสด"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Border Background="White"
                                BorderBrush="#DDE2E8"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="20,16">
                                    <TextBlock Text="รับเข้า"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeTotalIncomeText"
                                               Margin="0,5,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#047857" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="0,12"
                                        Background="#E5E7EB" />

                                <StackPanel Grid.Column="2"
                                            Margin="20,16">
                                    <TextBlock Text="จ่ายออก"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeTotalExpenseText"
                                               Margin="0,5,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Margin="0,12"
                                        Background="#E5E7EB" />

                                <Border Grid.Column="4"
                                        Background="#F8FAFC">
                                    <StackPanel Margin="22,16">
                                        <TextBlock Text="ยอดสุทธิ"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569" />
                                        <TextBlock x:Name="HomeNetCashText"
                                                   Margin="0,5,0,0"
                                                   FontSize="26"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="5"
                                        Margin="0,12"
                                        Background="#E5E7EB" />

                                <Border Grid.Column="6"
                                        Background="#F0FDF4"
                                        CornerRadius="0,9,9,0">
                                    <StackPanel Margin="22,16">
                                        <TextBlock Text="กำไร"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#166534" />
                                        <TextBlock x:Name="HomeProfitText"
                                                   Margin="0,5,0,0"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="#15803D" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- New pawn -->
                <ScrollViewer x:Name="NewPawnContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="32">

                        <!-- Existing customer lookup -->
                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="ลูกค้าเคยมาใช้บริการแล้ว?"
                                               FontSize="16"
                                               FontWeight="SemiBold"
