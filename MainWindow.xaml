                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#B45309" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#B91C1C" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
