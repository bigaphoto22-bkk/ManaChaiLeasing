                                                                <DataTrigger Binding="{Binding HasDueAlert}"
                                                                             Value="False">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#B91C1C" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#F8FAFC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="สถานะ"
                                                        Width="150">
