<Window x:Class="ManaChaiLeasing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManaChaiLeasing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static local:AppInfo.StoreName}"
        Width="1280"
        Height="760"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActiveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PlaceholderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FormSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="StaysOpenOnEdit" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <EventSetter Event="PreviewMouseLeftButtonUp"
                         Handler="FormComboBox_PreviewMouseLeftButtonUp" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="105" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="75" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0">
                        <TextBlock Text="{x:Static local:AppInfo.StoreName}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="0,18,0,0">

                    <TextBlock Text="เมนูหลัก"
                               Margin="30,0,0,10"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF" />

                    <Button x:Name="HomeButton"
                            Content="หน้าหลัก"
                            Style="{StaticResource SidebarActiveButtonStyle}"
                            Click="HomeButton_Click" />

                    <Button x:Name="NewPawnButton"
                            Content="รับจำนำใหม่"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NewPawnButton_Click" />

                    <Button x:Name="SearchButton"
                            Content="ค้นหารายการ"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SearchButton_Click" />

                    <Button x:Name="TodayButton"
                            Content="รายการวันนี้"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="TodayButton_Click" />

                    <Separator Margin="24,14"
                               Background="#E5E7EB" />

                    <Button x:Name="SettingsButton"
                            Content="ตั้งค่า"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SettingsButton_Click" />

                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0">
                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0">
                        <TextBlock Text="{x:Static local:AppInfo.StoreName}"
                                   FontSize="12"
                                   Foreground="#6B7280" />
                        <TextBlock x:Name="DatabaseStatusText"
                                   Text="กำลังเตรียมฐานข้อมูล..."
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#9CA3AF" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="หน้าหลัก"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <TextBlock x:Name="PageSubtitleText"
                                   Text="ระบบบันทึกข้อมูลลูกค้าและรายการรับจำนำ"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#F3F4F6"
                            CornerRadius="8"
                            Padding="14,8">
                        <TextBlock Text="Offline"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563" />
                    </Border>
                </Grid>

            </Border>

            <!-- Page content -->
            <Grid Grid.Row="1">

                <!-- Home -->
                <ScrollViewer x:Name="HomeContent"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">

                        <Border Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="26">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{x:Static local:AppInfo.StoreName}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#111827" />

                                    <TextBlock Margin="0,8,0,0"
                                               Text="ภาพรวมกิจการ ณ วันนี้"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151" />

                                    <TextBlock x:Name="HomeDashboardDateText"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               Foreground="#6B7280" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right">
                                    <Button Width="140"
                                            Height="44"
                                            Content="รีเฟรช"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshHomeDashboardButton_Click" />

                                    <TextBlock x:Name="HomeDashboardUpdatedText"
                                               Margin="0,7,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,28,0,14"
                                   Text="ภาพรวมวันนี้"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="กำลังจำนำ"
                                               FontSize="15"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeActiveTicketCountText"
                                               Margin="0,8,0,0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#15803D" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="ตั๋วที่ยัง Active ทั้งหมด"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="ครบกำหนดวันนี้"
                                               FontSize="15"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeDueTodayCountText"
                                               Margin="0,8,0,0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="ตั๋ว Active ที่ถึงกำหนดวันนี้"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                    <TextBlock x:Name="HomeOverdueCountText"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#B91C1C" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="ต่อดอกวันนี้"
                                               FontSize="15"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeInterestTodayCountText"
                                               Margin="0,8,0,0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#1D4ED8" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="จำนวนครั้งที่รับชำระดอกวันนี้"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="จ่ายออกวันนี้"
                                               FontSize="15"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomePawnExpenseTodayText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#B45309" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="เงินต้นที่จ่ายจากการรับจำนำ"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="รับเข้าวันนี้"
                                               FontSize="15"
                                               Foreground="#6B7280" />
                                    <TextBlock x:Name="HomeIncomeTodayText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#047857" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="ต่อดอก + ไถ่ถอน"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="22"
                                    Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="เงินสุทธิวันนี้"
                                               FontSize="15"
                                               Foreground="#475569" />
                                    <TextBlock x:Name="HomeNetCashTodayText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="รับเข้า - จ่ายออก"
                                               FontSize="12"
                                               Foreground="#9CA3AF" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,26,0,0"
                                Padding="20"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="Phase 2H.1 : Home Dashboard Summary — แสดงภาพรวมตั๋วและเงินเข้าออกประจำวันจาก SQLite"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap" />
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- New pawn -->
                <ScrollViewer x:Name="NewPawnContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="32">

                        <!-- Existing customer lookup -->
                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="ลูกค้าเคยมาใช้บริการแล้ว?"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#1E3A8A" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="ค้นหาลูกค้าเก่าจากชื่อ นามสกุล เลขบัตรประชาชน เบอร์โทรศัพท์ หรือที่อยู่ แล้วดึงข้อมูลเดิมมาใช้ได้ทันที"
                                               FontSize="13"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Width="150"
                                        Content="ค้นหาลูกค้าเก่า"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="SearchExistingCustomer_Click" />
                            </Grid>

                        </Border>

                        <!-- Ticket -->
                        <Border Margin="0,18,0,0"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <StackPanel>

                                <TextBlock Text="ข้อมูลตั๋ว"
                                           Style="{StaticResource FormSectionTitleStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="หมายเลขตั๋ว *"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="TicketNumberTextBox"
                                                 Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="วันที่รับจำนำ *"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <DatePicker x:Name="PawnDatePicker"
                                                    Height="40"
                                                    FontSize="14"
                                                    BorderBrush="#D1D5DB"
                                                    BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- Customer -->
                        <Border Margin="0,18,0,0"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="ข้อมูลลูกค้า"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />

                                        <TextBlock x:Name="CustomerRecordStatusText"
                                                   Margin="0,4,0,0"
                                                   Text="ลูกค้าใหม่ • ยังไม่ได้บันทึก"
                                                   FontSize="12"
                                                   Foreground="#6B7280" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="150"
                                            Content="บันทึกลูกค้า"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SaveCustomerButton_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="ชื่อ *"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="FirstNameTextBox"
                                                 Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="นามสกุล *"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="LastNameTextBox"
                                                 Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="เลขบัตรประชาชน"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="CitizenIdTextBox"
                                                 MaxLength="13"
                                                 Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="อายุ"
                                                       Style="{StaticResource FormLabelStyle}" />
                                            <TextBox x:Name="AgeTextBox"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="เบอร์โทรศัพท์"
                                                       Style="{StaticResource FormLabelStyle}" />
                                            <TextBox x:Name="PhoneTextBox"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3">
                                        <TextBlock Text="ที่อยู่"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="AddressTextBox"
                                                 Height="76"
                                                 Padding="10,8"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#D1D5DB"
                                                 BorderThickness="1" />
                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- Asset -->
                        <Border Margin="0,18,0,0"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <StackPanel>

                                <TextBlock Text="ข้อมูลสินค้า"
                                           Style="{StaticResource FormSectionTitleStyle}" />

                                <!-- Category + amount -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
